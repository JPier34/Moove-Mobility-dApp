"use client";

import React, {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useReducer,
  useRef,
  useState,
} from "react";
import { useWonAuctionsManager } from "@/hooks/useWonAuctionsManager";
import ConsolidatedNotificationBadge from "@/components/notifications/ConsolidatedNotificationBadge";
import AuctionNotificationsDebug from "@/components/debug/AuctionNotificationsDebug";
import { useSealedBidAutoMonitor } from "@/hooks/useSealedBidStatusManager";
import { useAccount } from "wagmi";
import { ethers } from "ethers";
import toast from "react-hot-toast";
import { WonAuction } from "@/types/user";
import { contracts } from "@/utils/contracts";

// ============= CONTEXT =============

interface TransactionResult {
  success: boolean;
  hash?: string;
  error?: string;
}

interface RefundNotification {
  id: string;
  auctionId: string;
  amount: string;
  transactionHash: string;
  timestamp: number;
  isRead: boolean;
  message: string;
}

interface ClaimNotification {
  id: string;
  auctionId: string;
  message: string;
  timestamp: number;
  isRead: boolean;
  transactionHash?: string;
  priority: "high" | "medium" | "low";
  isPermanent: boolean; // ✅ NEW: Claim notifications are permanent and cannot be dismissed
}

interface AuctionNotificationsContextType {
  hasUnsettledAuctions: boolean;
  unsettledCount: number;
  showNotifications: boolean;
  setShowNotifications: (show: boolean) => void;
  currentAuction: WonAuction | null;
  unsettledAuctions: WonAuction[];
  isSettling: boolean;
  transactionHash: string | null;
  isWaitingForConfirmation: boolean;
  handleSettleAuction: (auctionId: string, auction: WonAuction) => void;
  // New 3-phase system states
  showConfirmationModal: boolean;
  showResultModal: boolean;
  selectedAuction: WonAuction | null;
  transactionResult: TransactionResult | null;
  // Sealed bid monitoring
  addToSealedBidMonitoring: (auctionId: number) => void;
  removeFromSealedBidMonitoring: (auctionId: number) => void;
  monitoredSealedBidAuctions: number[];
  isMonitoringSealedBids: boolean;
  sealedBidError: string | null;
  // Refund notifications
  refundNotifications: RefundNotification[];
  markRefundAsRead: (notificationId: string) => void;
  clearAllRefundNotifications: () => void;
  removeRefundNotification: (notificationId: string) => void;
  // Claim notifications
  claimNotifications: ClaimNotification[];
  markClaimAsRead: (notificationId: string) => void;
  clearAllClaimNotifications: () => void;
  removeClaimNotification: (notificationId: string) => void;
  claimPermanentNotification: (notificationId: string) => void; // ✅ NEW: Claim permanent notifications
  removeDuplicatesFromNotifications: () => void; // ✅ NEW: Remove duplicates from existing notifications
  emergencyCleanup: () => void; // ✅ NEW: Emergency complete cleanup
  // Debug functions
  resetRefundBlock: () => void;
  resetClaimBlock: () => void;
  clearAllNotifications: () => void;
}

const AuctionNotificationsContext =
  createContext<AuctionNotificationsContextType | null>(null);

export const useAuctionNotifications = () => {
  const context = useContext(AuctionNotificationsContext);
  if (!context) {
    throw new Error(
      "useAuctionNotifications must be used within an AuctionNotificationsProvider"
    );
  }
  return context;
};

// ✅ OPTIMIZATION: Notification state reducer for complex state management
type NotificationAction =
  | { type: "ADD_REFUND"; payload: RefundNotification }
  | { type: "ADD_CLAIM"; payload: ClaimNotification }
  | { type: "REMOVE_REFUND"; payload: string }
  | { type: "REMOVE_CLAIM"; payload: string }
  | { type: "MARK_REFUND_READ"; payload: string }
  | { type: "MARK_CLAIM_READ"; payload: string }
  | { type: "CLEAR_ALL_REFUND" }
  | { type: "CLEAR_ALL_CLAIM" }
  | { type: "SET_REFUND_NOTIFICATIONS"; payload: RefundNotification[] }
  | { type: "SET_CLAIM_NOTIFICATIONS"; payload: ClaimNotification[] }
  | { type: "ADD_PROCESSED_AUCTION"; payload: string }
  | { type: "SET_PROCESSED_AUCTIONS"; payload: Set<string> };

interface NotificationState {
  refundNotifications: RefundNotification[];
  claimNotifications: ClaimNotification[];
  processedClaimAuctions: Set<string>;
}

const notificationReducer = (
  state: NotificationState,
  action: NotificationAction
): NotificationState => {
  switch (action.type) {
    case "ADD_REFUND":
      return {
        ...state,
        refundNotifications: [action.payload, ...state.refundNotifications],
      };
    case "ADD_CLAIM":
      return {
        ...state,
        claimNotifications: [action.payload, ...state.claimNotifications],
      };
    case "REMOVE_REFUND":
      return {
        ...state,
        refundNotifications: state.refundNotifications.filter(
          (n) => n.id !== action.payload
        ),
      };
    case "REMOVE_CLAIM":
      return {
        ...state,
        // ✅ PERMANENT CLAIM NOTIFICATIONS: Only remove if not permanent
        claimNotifications: state.claimNotifications.filter(
          (n) => n.id !== action.payload && !n.isPermanent
        ),
        processedClaimAuctions: new Set([
          ...state.processedClaimAuctions,
          action.payload,
        ]),
      };
    case "MARK_REFUND_READ":
      return {
        ...state,
        refundNotifications: state.refundNotifications.map((n) =>
          n.id === action.payload ? { ...n, isRead: true } : n
        ),
      };
    case "MARK_CLAIM_READ":
      return {
        ...state,
        claimNotifications: state.claimNotifications.map((n) =>
          n.id === action.payload ? { ...n, isRead: true } : n
        ),
      };
    case "CLEAR_ALL_REFUND":
      return {
        ...state,
        refundNotifications: [],
      };
    case "CLEAR_ALL_CLAIM":
      return {
        ...state,
        // ✅ PERMANENT CLAIM NOTIFICATIONS: Only clear non-permanent ones
        claimNotifications: state.claimNotifications.filter(
          (n) => n.isPermanent
        ),
        processedClaimAuctions: new Set([
          ...state.processedClaimAuctions,
          ...state.claimNotifications
            .filter((n) => !n.isPermanent)
            .map((n) => n.auctionId),
        ]),
      };
    case "SET_REFUND_NOTIFICATIONS":
      return {
        ...state,
        refundNotifications: action.payload,
      };
    case "SET_CLAIM_NOTIFICATIONS":
      return {
        ...state,
        claimNotifications: action.payload,
      };
    case "ADD_PROCESSED_AUCTION":
      return {
        ...state,
        processedClaimAuctions: new Set([
          ...state.processedClaimAuctions,
          action.payload,
        ]),
      };
    case "SET_PROCESSED_AUCTIONS":
      return {
        ...state,
        processedClaimAuctions: action.payload,
      };
    default:
      return state;
  }
};

// ✅ OPTIMIZATION: Custom debounce hook for API calls
const useDebounce = <T extends (...args: any[]) => any>(
  callback: T,
  delay: number
): T => {
  const timeoutRef = useRef<NodeJS.Timeout>();

  return useCallback(
    ((...args: Parameters<T>) => {
      if (timeoutRef.current) {
        clearTimeout(timeoutRef.current);
      }
      timeoutRef.current = setTimeout(() => {
        callback(...args);
      }, delay);
    }) as T,
    [callback, delay]
  );
};
const useNotificationManager = () => {
  const [notificationState, dispatch] = useReducer(notificationReducer, {
    refundNotifications: [],
    claimNotifications: [],
    processedClaimAuctions: new Set<string>(),
  });

  const addRefundNotification = useCallback(
    (notification: RefundNotification) => {
      dispatch({ type: "ADD_REFUND", payload: notification });
    },
    []
  );

  const addClaimNotification = useCallback(
    (notification: ClaimNotification) => {
      dispatch({ type: "ADD_CLAIM", payload: notification });
    },
    []
  );

  const removeRefundNotification = useCallback((notificationId: string) => {
    dispatch({ type: "REMOVE_REFUND", payload: notificationId });
  }, []);

  const removeClaimNotification = useCallback((notificationId: string) => {
    dispatch({ type: "REMOVE_CLAIM", payload: notificationId });
  }, []);

  const markRefundAsRead = useCallback((notificationId: string) => {
    dispatch({ type: "MARK_REFUND_READ", payload: notificationId });
  }, []);

  const markClaimAsRead = useCallback((notificationId: string) => {
    dispatch({ type: "MARK_CLAIM_READ", payload: notificationId });
  }, []);

  const clearAllRefundNotifications = useCallback(() => {
    dispatch({ type: "CLEAR_ALL_REFUND" });
  }, []);

  const clearAllClaimNotifications = useCallback(() => {
    dispatch({ type: "CLEAR_ALL_CLAIM" });
  }, []);

  // ✅ NEW: Special function to handle claim of permanent notifications
  const claimPermanentNotification = useCallback((notificationId: string) => {
    // Mark as read but keep the notification (it's permanent)
    dispatch({ type: "MARK_CLAIM_READ", payload: notificationId });

    console.log(
      `🏆 [Claim] Permanent notification ${notificationId} marked as claimed`
    );
  // ✅ Save/load functions for localStorage
  const saveRefundNotifications = useCallback((notifications: RefundNotification[]) => {
    if (typeof window === "undefined") return;
    try {
      localStorage.setItem(
        "moove-refund-notifications",
        JSON.stringify(notifications)
      );
    } catch (error) {
      console.warn("Failed to save refund notifications:", error);
    }
  }, []);

  const saveClaimNotifications = useCallback((notifications: ClaimNotification[]) => {
    if (typeof window === "undefined") return;
    try {
      localStorage.setItem(
        "moove-claim-notifications",
        JSON.stringify(notifications)
      );
    } catch (error) {
      console.warn("Failed to save claim notifications:", error);
    }
  const saveClaimNotifications = useCallback((notifications: ClaimNotification[]) => {
    if (typeof window === "undefined") return;
    try {
      localStorage.setItem(
        "moove-claim-notifications",
        JSON.stringify(notifications)
      );
    } catch (error) {
      console.warn("Failed to save claim notifications:", error);
    }
  }, []);

  const loadRefundNotifications = useCallback((): RefundNotification[] => {
    if (typeof window === "undefined") return [];
    try {
      const stored = localStorage.getItem("moove-refund-notifications");
      if (stored) {
        const parsed = JSON.parse(stored);
        return Array.isArray(parsed) ? parsed : [];
      }
    } catch (error) {
      console.warn("Failed to load refund notifications:", error);
    }
    return [];
  }, []);

  const loadClaimNotifications = useCallback((): ClaimNotification[] => {
    if (typeof window === "undefined") return [];
    try {
      const stored = localStorage.getItem("moove-claim-notifications");
      if (stored) {
        const parsed = JSON.parse(stored);
        return Array.isArray(parsed) ? parsed : [];
      }
    } catch (error) {
      console.warn("Failed to load claim notifications:", error);
    }
    return [];
  }, []);

  // ✅ Auto-save notifications to localStorage when they change
  useEffect(() => {
    saveRefundNotifications(notificationState.refundNotifications);
  }, [notificationState.refundNotifications, saveRefundNotifications]);

  useEffect(() => {
    saveClaimNotifications(notificationState.claimNotifications);
  }, [notificationState.claimNotifications, saveClaimNotifications]);

  return {
    ...notificationState,
    addRefundNotification,
    addClaimNotification,
    removeRefundNotification,
    removeClaimNotification,
    markRefundAsRead,
    markClaimAsRead,
    clearAllRefundNotifications,
    clearAllClaimNotifications,
    claimPermanentNotification, // ✅ NEW: Function to claim permanent notifications
    saveRefundNotifications,
    saveClaimNotifications,
    loadRefundNotifications,
    loadClaimNotifications,
  };
};

export const AuctionNotificationsProvider: React.FC<{
  children: React.ReactNode;
}> = ({ children }) => {
  const { address, isConnected } = useAccount();
  const {
    unsettledAuctions: wonAuctions,
    currentAuction,
    isSettling,
    handleSettleAuction,
  } = useWonAuctionsManager();

  // Mock states for compatibility
  const transactionHash = null;
  const isWaitingForConfirmation = false;

  // New 3-phase system states
  const [showConfirmationModal, setShowConfirmationModal] = useState(false);
  const [showResultModal, setShowResultModal] = useState(false);
  const [selectedAuction, setSelectedAuction] = useState<WonAuction | null>(
    null
  );
  const [transactionResult, setTransactionResult] =
    useState<TransactionResult | null>(null);

  // Sealed bid monitoring
  const {
    addToMonitoring,
    removeFromMonitoring,
    monitoredAuctions,
    isProcessing: isMonitoringSealedBids,
    error: sealedBidError,
  } = useSealedBidAutoMonitor();

  // Notification visibility state
  const [showNotifications, setShowNotifications] = useState(true);

  // Stato per tracciare se l'utente ha già visto le notifiche
  const [hasSeenNotifications, setHasSeenNotifications] = useState(false);

  // ✅ OPTIMIZATION: Use custom hook for notification management
  const notificationManager = useNotificationManager();
  const {
    refundNotifications,
    claimNotifications,
    processedClaimAuctions,
    addRefundNotification,
    addClaimNotification,
    removeRefundNotification,
    removeClaimNotification,
    markRefundAsRead,
    markClaimAsRead,
    clearAllRefundNotifications,
    clearAllClaimNotifications,
    claimPermanentNotification, // ✅ NEW: Function to claim permanent notifications
    saveRefundNotifications,
    saveClaimNotifications,
    loadRefundNotifications,
    loadClaimNotifications,
  } = notificationManager;

  // Additional state for block tracking
  const [lastCheckedBlock, setLastCheckedBlock] = useState<number>(0);
  const [lastCheckedClaimBlock, setLastCheckedClaimBlock] = useState<number>(0);

  // Save/load processed claim auctions from localStorage
  const saveProcessedClaimAuctions = (auctions: Set<string>) => {
    if (typeof window === "undefined") return;
    try {
      // ✅ Ensure all auction IDs are strings to avoid BigInt serialization issues
      const stringArray = Array.from(auctions).map((id) => String(id));
      localStorage.setItem(
        "moove-processed-claim-auctions",
        JSON.stringify(stringArray)
      );
      console.log(
        `💾 [Claim] Saved ${stringArray.length} processed auctions to localStorage`
      );
    } catch (error) {
      console.warn("Failed to save processed claim auctions:", error);
    }
  };

  const loadProcessedClaimAuctions = (): Set<string> => {
    if (typeof window === "undefined") return new Set();
    try {
      const stored = localStorage.getItem("moove-processed-claim-auctions");
      if (stored) {
        const parsed = JSON.parse(stored);
        return new Set(Array.isArray(parsed) ? parsed : []);
      }
    } catch (error) {
      console.warn("Failed to load processed claim auctions:", error);
    }
    return new Set();
  };

  // ✅ OPTIMIZATION: Memoized filtered notifications to prevent unnecessary re-renders
  const unreadRefundNotifications = useMemo(() => {
    return refundNotifications.filter((n) => !n.isRead);
  }, [refundNotifications]);

  const unreadClaimNotifications = useMemo(() => {
    return claimNotifications.filter((n) => !n.isRead);
  }, [claimNotifications]);

  const totalUnreadCount = useMemo(() => {
    return unreadRefundNotifications.length + unreadClaimNotifications.length;
  }, [unreadRefundNotifications.length, unreadClaimNotifications.length]);

  // Reset functions for debugging
  const resetRefundBlock = () => {
    console.log(`🔄 [Refund] Manually resetting lastCheckedBlock to 0`);
    setLastCheckedBlock(0);
  };

  const resetClaimBlock = () => {
    console.log(`🔄 [Claim] Manually resetting lastCheckedClaimBlock to 0`);
    setLastCheckedClaimBlock(0);
  };

  const clearAllNotifications = () => {
    console.log(
      `🧹 [All] Clearing all notifications (except permanent claim notifications)`
    );
    clearAllRefundNotifications();
    clearAllClaimNotifications(); // This now preserves permanent claim notifications
    setLastCheckedBlock(0);
    setLastCheckedClaimBlock(0);

    // Clear localStorage
    if (typeof window !== "undefined") {
      localStorage.removeItem("moove-refund-notifications");
      localStorage.removeItem("moove-claim-notifications");
      localStorage.removeItem("moove-last-checked-block");
      localStorage.removeItem("moove-last-checked-claim-block");
    }
  };

  // Fetch refund events from blockchain
  // ✅ Memoize functions to prevent unnecessary re-renders
  const fetchRefundEvents = useCallback(async () => {
    if (!address || !isConnected) {
      console.log(
        `🔍 [Refund] Skipping fetch - not connected (address: ${address}, connected: ${isConnected})`
      );
        return;
      }

    console.log(`🔍 [Refund] Starting fetch for user ${address}`);

      try {
      const provider = new ethers.JsonRpcProvider(
        process.env.NEXT_PUBLIC_RPC_URL || "https://1rpc.io/sepolia"
        );
        const auctionContract = new ethers.Contract(
        contracts.MooveAuction.address,
        contracts.MooveAuction.abi,
          provider
        );

      // Get current block
      const currentBlock = await provider.getBlockNumber();
      const fromBlock = Math.max(lastCheckedBlock, currentBlock - 10000); // Last 10000 blocks max

      console.log(
        `🔍 [Refund] Block range: ${fromBlock} → ${currentBlock} (lastChecked: ${lastCheckedBlock})`
      );

      if (fromBlock >= currentBlock) {
        console.log(
          `⏭️ [Refund] No new blocks to check (fromBlock: ${fromBlock}, currentBlock: ${currentBlock})`
        );
        return;
      }

      console.log(
        `🔍 [Refund] Fetching refund events from block ${fromBlock} to ${currentBlock}`
      );

      // Fetch BidRefunded events
      const refundEvents = await auctionContract.queryFilter(
        auctionContract.filters.BidRefunded(),
        fromBlock,
        currentBlock
      );

      console.log(
        `📊 [Refund] Found ${refundEvents.length} BidRefunded events`
      );

      // Process events for current user
      const userRefundEvents = refundEvents.filter((event) => {
        const bidder = (event as any).args?.bidder;
        return bidder && bidder.toLowerCase() === address.toLowerCase();
      });

              console.log(
        `👤 [Refund] Found ${userRefundEvents.length} refund events for current user ${address}`
      );

      if (userRefundEvents.length > 0) {
        console.log(
          `👤 [Refund] Processing ${userRefundEvents.length} refund events for current user`
        );

        const newNotifications: RefundNotification[] = [];

        for (const event of userRefundEvents) {
          const args = (event as any).args;
          const auctionId = args?.auctionId;
          const bidder = args?.bidder;
          const amount = args?.amount;

          if (!auctionId || !bidder || !amount) {
            console.warn(`⚠️ [Refund] Skipping event with missing data:`, {
                  auctionId,
              bidder,
              amount,
            });
            continue;
          }

          console.log(
            `💰 [Refund] Processing refund: auction ${auctionId}, bidder ${bidder}, amount ${ethers.formatEther(
              amount
            )} ETH`
          );

          const notification: RefundNotification = {
            id: `${auctionId}-refund-${event.blockNumber}-${event.transactionHash}`,
            auctionId: auctionId.toString(),
            amount: ethers.formatEther(amount),
            transactionHash: event.transactionHash,
            timestamp: Date.now(),
            isRead: false,
            message: `Your offer on auction #${auctionId} has been overcome! You received a refund of ${ethers.formatEther(
              amount
            )} ETH.`,
          };

          newNotifications.push(notification);
        }

        // ✅ FILTER: Only add truly new notifications (avoid duplicates)
        const existingIds = new Set(refundNotifications.map((n) => n.id));
        const trulyNewNotifications = newNotifications.filter(
          (n) => !existingIds.has(n.id)
        );

              console.log(
          `📊 [Refund] Found ${newNotifications.length} notifications, ${
            trulyNewNotifications.length
          } are new (${
            newNotifications.length - trulyNewNotifications.length
          } duplicates filtered)`
        );

        // Add only new notifications using dispatch
        trulyNewNotifications.forEach((notification) => {
          addRefundNotification(notification);
        });

        // Update localStorage
        const merged = [...refundNotifications, ...trulyNewNotifications];
        console.log(
          `💾 [Refund] Saving ${merged.length} total notifications (${trulyNewNotifications.length} new)`
        );
        saveRefundNotifications(merged);

        // Show toast notifications for new refunds
        newNotifications.forEach((notification) => {
          console.log(`🔔 [Refund] Showing toast: ${notification.message}`);
          toast.success(notification.message, {
            duration: 5000,
            position: "top-right",
          });
        });
      } else {
        console.log(
          `👤 [Refund] No refund events found for current user ${address}`
        );
      }

      // Update last checked block
      console.log(
        `📝 [Refund] Updating lastCheckedBlock from ${lastCheckedBlock} to ${currentBlock}`
      );
      setLastCheckedBlock(currentBlock);
    } catch (error) {
      console.error("Error fetching refund events:", error);
    }
  }, [address, isConnected]); // ✅ Removed lastCheckedBlock - managed internally

  // Fetch claim events from blockchain
  const fetchClaimEvents = useCallback(async () => {
    if (!address || !isConnected) {
                console.log(
        `🔍 [Claim] Skipping fetch - not connected (address: ${address}, connected: ${isConnected})`
      );
      return;
    }

    console.log(`🔍 [Claim] Starting fetch for user ${address}`);

    try {
      const provider = new ethers.JsonRpcProvider(
        process.env.NEXT_PUBLIC_RPC_URL || "https://1rpc.io/sepolia"
      );
      const auctionContract = new ethers.Contract(
        contracts.MooveAuction.address,
        contracts.MooveAuction.abi,
        provider
      );

      // Get current block
      const currentBlock = await provider.getBlockNumber();
      const fromBlock = Math.max(lastCheckedClaimBlock, currentBlock - 10000); // Last 10000 blocks max

                console.log(
        `🔍 [Claim] Block range: ${fromBlock} → ${currentBlock} (lastCheckedClaim: ${lastCheckedClaimBlock})`
      );

      if (fromBlock >= currentBlock) {
        console.log(
          `⏭️ [Claim] No new blocks to check (fromBlock: ${fromBlock}, currentBlock: ${currentBlock})`
        );
        return;
      }

      console.log(
        `🔍 [Claim] Fetching claim events from block ${fromBlock} to ${currentBlock}`
      );

      // Fetch both AuctionSettled and AuctionEnded events
      const [settledEvents, endedEvents] = await Promise.all([
        auctionContract.queryFilter(
          auctionContract.filters.AuctionSettled(null, address),
          fromBlock,
          currentBlock
        ),
        auctionContract.queryFilter(
          auctionContract.filters.AuctionEnded(),
          fromBlock,
          currentBlock
        ),
      ]);

      console.log(
        `📊 [Claim] Found ${settledEvents.length} AuctionSettled events and ${endedEvents.length} AuctionEnded events`
      );

      // Process AuctionSettled events (these have winner information)
      const userSettledEvents = settledEvents.filter((event) => {
        const winner = (event as any).args?.winner;
        return winner && winner.toLowerCase() === address.toLowerCase();
      });

      // Process AuctionEnded events (need to check winner manually)
      const userEndedEvents = [];
      for (const event of endedEvents) {
        const auctionId = (event as any).args?.auctionId;
        if (auctionId) {
          try {
            // Get auction data to check winner
            const auctionData = await auctionContract.getAuction(auctionId);
            const winner = auctionData.highestBidder;
            if (winner && winner.toLowerCase() === address.toLowerCase()) {
              userEndedEvents.push(event);
            }
          } catch (error) {
            console.warn(
              `⚠️ [Claim] Could not check winner for auction ${auctionId}:`,
              error
            );
          }
        }
      }

      const allUserEvents = [...userSettledEvents, ...userEndedEvents];
      console.log(
        `👤 [Claim] Found ${allUserEvents.length} claim events for current user ${address} (${userSettledEvents.length} settled + ${userEndedEvents.length} ended)`
      );

      // ✅ OPTIMIZATION: Only check recent auctions to prevent spam
      console.log(
        `🔍 [Claim] Checking for recent expired auctions where user is winner...`
      );
      const expiredWinnerAuctions = [];

      try {
        // ✅ REDUCED SCOPE: Only check last 10 auctions to prevent spam
        const maxCheckAuctions = 10;
        let totalAuctions = 0;

        // Find the highest auction ID by checking backwards
        for (let i = maxCheckAuctions; i >= 1; i--) {
          try {
            const auctionData = await auctionContract.getAuction(i);
            if (
              auctionData &&
              auctionData.seller !==
                "0x0000000000000000000000000000000000000000"
            ) {
              totalAuctions = i;
              break;
            }
          } catch (error) {
            // Auction doesn't exist, continue checking
            continue;
          }
        }

        console.log(
          `📊 [Claim] Found ${totalAuctions} total auctions (checked up to ${maxCheckAuctions})`
        );

        // ✅ REDUCED SCOPE: Only check last 5 auctions for expired ones
        const startAuction = Math.max(1, totalAuctions - 5);
        for (
          let auctionId = startAuction;
          auctionId <= totalAuctions;
          auctionId++
        ) {
          try {
            const auctionData = await auctionContract.getAuction(auctionId);
            const status = Number(auctionData.status);
            const endTime = Number(auctionData.endTime);
            const highestBidder = auctionData.highestBidder;
            const auctionType = Number(auctionData.auctionType);
            const now = Math.floor(Date.now() / 1000);

            // Skip Dutch auctions (they settle immediately on purchase)
            if (auctionType === 1) {
              continue;
            }

            // ✅ ADDITIONAL FILTER: Only check auctions that ended in the last 7 days
            const sevenDaysAgo = now - 7 * 24 * 60 * 60; // 7 days in seconds
            const isRecent = endTime > sevenDaysAgo;

            // Check if auction is ACTIVE but expired and user is winner AND recent
            if (
              status === 1 &&
              now > endTime &&
              isRecent &&
              highestBidder.toLowerCase() === address.toLowerCase()
            ) {
              console.log(
                `🏆 [Claim] Found recent expired auction ${auctionId} where user is winner:`,
                {
                  status,
                  endTime,
                  now,
                  highestBidder,
                  auctionType,
                  isExpired: now > endTime,
                  isRecent,
                }
              );

              expiredWinnerAuctions.push({
                auctionId: auctionId.toString(),
                endTime,
                highestBidder,
                blockNumber: 0, // No specific block
                transactionHash: "expired-auction",
              });
            }
          } catch (error) {
            // Skip invalid auctions
            continue;
          }
        }

        console.log(
          `🏆 [Claim] Found ${expiredWinnerAuctions.length} recent expired auctions where user is winner`
        );
          } catch (error) {
        console.warn(`⚠️ [Claim] Error checking expired auctions:`, error);
      }

      const allClaimableAuctions = [...allUserEvents, ...expiredWinnerAuctions];
            console.log(
        `👤 [Claim] Total claimable auctions: ${allClaimableAuctions.length} (${allUserEvents.length} from events + ${expiredWinnerAuctions.length} expired)`
      );

      if (allClaimableAuctions.length > 0) {
        console.log(
          `👤 [Claim] Processing ${allClaimableAuctions.length} claim events for current user`
        );

        const newNotifications: ClaimNotification[] = [];

        for (const auction of allClaimableAuctions) {
          let auctionId: string;

          // Handle different auction object types
          if ("auctionId" in auction) {
            // Expired auction object
            auctionId = auction.auctionId;
          } else {
            // Event object
            const args = (auction as any).args;
            auctionId = args?.auctionId;
          }

          if (!auctionId) {
            console.warn(
              `⚠️ [Claim] Skipping auction with missing auctionId:`,
              auction
            );
            continue;
          }

          // ✅ FILTER: Only process auctions from #30 onwards
          if (Number(auctionId) < 30) {
        console.log(
              `⏭️ [Claim] Skipping old auction ${auctionId} (only processing #30+)`
            );
            continue;
          }

          // Check if we already processed this auction
          if (processedClaimAuctions.has(String(auctionId))) {
            console.log(
              `⏭️ [Claim] Skipping already processed auction ${auctionId}`
            );
            continue;
          }

          // ✅ CHECK: Verify auction is actually claimable by checking contract status
          try {
            const auctionData = await auctionContract.getAuction(auctionId);
            const status = Number(auctionData.status);

            // Skip if auction is already settled (status 4)
            if (status === 4) {
              console.log(
                `⏭️ [Claim] Skipping already settled auction ${auctionId} (status: ${status})`
              );
              continue;
            }

            // Skip if auction is cancelled (status 5)
            if (status === 5) {
              console.log(
                `⏭️ [Claim] Skipping cancelled auction ${auctionId} (status: ${status})`
              );
              continue;
            }
      } catch (error) {
            console.warn(
              `⚠️ [Claim] Could not verify auction ${auctionId} status:`,
          error
        );
            continue;
          }

          console.log(`🏆 [Claim] Processing claim: auction ${auctionId}`);

          const notification: ClaimNotification = {
            id: `${auctionId}-claim-${
              "blockNumber" in auction ? auction.blockNumber : Date.now()
            }-${Date.now()}`,
            auctionId: auctionId.toString(),
            message: `🎉 You won auction #${auctionId}! Click to claim your NFT.`,
            timestamp: Date.now(),
            isRead: false,
            transactionHash:
              "transactionHash" in auction
                ? auction.transactionHash
                : "expired-auction",
            priority: "high",
            isPermanent: true, // ✅ PERMANENT: Claim notifications cannot be dismissed
          };

          newNotifications.push(notification);

          // Mark auction as processed using dispatch
          addClaimNotification(notification);

          // Update processed auctions
          const newSet = new Set([
            ...processedClaimAuctions,
            String(auctionId),
          ]);
          saveProcessedClaimAuctions(newSet);
        }

        // ✅ FILTER: Only add truly new notifications (avoid duplicates)
        const existingClaimIds = new Set(claimNotifications.map((n) => n.id));
        const trulyNewClaimNotifications = newNotifications.filter(
          (n) => !existingClaimIds.has(n.id)
        );

        console.log(
          `📊 [Claim] Found ${newNotifications.length} notifications, ${
            trulyNewClaimNotifications.length
          } are new (${
            newNotifications.length - trulyNewClaimNotifications.length
          } duplicates filtered)`
        );

        // Add only new notifications using dispatch
        trulyNewClaimNotifications.forEach((notification) => {
          addClaimNotification(notification);
        });

        // Update localStorage
        const merged = [...claimNotifications, ...trulyNewClaimNotifications];
        console.log(
          `💾 [Claim] Saving ${merged.length} total notifications (${trulyNewClaimNotifications.length} new)`
        );
        saveClaimNotifications(merged);

        // Show toast notifications for new claims
        newNotifications.forEach((notification) => {
          console.log(`🔔 [Claim] Showing toast: ${notification.message}`);
          toast.success(notification.message, {
            duration: 8000,
            position: "top-right",
          });
        });
      } else {
        console.log(
          `👤 [Claim] No claim events found for current user ${address}`
        );
      }

      // Update last checked block
      console.log(
        `📝 [Claim] Updating lastCheckedClaimBlock from ${lastCheckedClaimBlock} to ${currentBlock}`
      );
      setLastCheckedClaimBlock(currentBlock);
    } catch (error) {
      console.error("Error fetching claim events:", error);
    }
  }, [address, isConnected]); // ✅ Removed lastCheckedClaimBlock - managed internally

  // Initialize refund notifications from localStorage
  useEffect(() => {
    // ✅ Add a small delay to prevent immediate execution on page reload
    const timer = setTimeout(() => {
      const stored = loadRefundNotifications();
      console.log(
        `📂 [Refund] Loading ${stored.length} stored notifications from localStorage`
      );

      // Filter out read notifications (keep only unread ones)
      const unreadNotifications = stored.filter(
        (notification) => !notification.isRead
      );

      console.log(
        `📂 [Refund] Filtered to ${
          unreadNotifications.length
        } unread notifications (removed ${
          stored.length - unreadNotifications.length
        } read)`
      );

      // Update refund notifications using dispatch
      unreadNotifications.forEach((notification) => {
        addRefundNotification(notification);
      });

      // Save filtered notifications back to localStorage
      if (unreadNotifications.length !== stored.length) {
        saveRefundNotifications(unreadNotifications);
      }

      // Reset lastCheckedBlock if no stored notifications
      if (stored.length === 0) {
        console.log(
          `🔄 [Refund] No stored notifications found, resetting lastCheckedBlock to 0`
        );
        setLastCheckedBlock(0);
      }
    }, 100); // ✅ Small delay to prevent immediate execution

    return () => clearTimeout(timer);
  }, []);

  // Initialize claim notifications from localStorage
  useEffect(() => {
    // ✅ Add a small delay to prevent immediate execution on page reload
    const timer = setTimeout(() => {
      const stored = loadClaimNotifications();
      const processedAuctions = loadProcessedClaimAuctions();

      console.log(
        `📂 [Claim] Loading ${stored.length} stored notifications from localStorage`
      );
      console.log(
        `📂 [Claim] Loading ${processedAuctions.size} processed auctions from localStorage`
      );

      // Filter out notifications for auctions that have already been processed or read
      const validNotifications = stored.filter((notification) => {
        const auctionId = notification.auctionId;
        const isProcessed = processedAuctions.has(auctionId);
        const isRead = notification.isRead;

        if (isProcessed) {
        console.log(
            `🗑️ [Claim] Removing processed notification for auction ${auctionId}`
          );
          return false;
        }

        if (isRead) {
          console.log(
            `🗑️ [Claim] Removing read notification for auction ${auctionId}`
          );
          return false;
        }

        return true;
      });

      console.log(
        `📂 [Claim] Filtered to ${
          validNotifications.length
        } valid notifications (removed ${
          stored.length - validNotifications.length
        } processed)`
      );

      // Update claim notifications using dispatch
      validNotifications.forEach((notification) => {
        addClaimNotification(notification);
      });

      // Update processed auctions
      processedAuctions.forEach((auctionId) => {
        const newSet = new Set([...processedClaimAuctions, auctionId]);
        saveProcessedClaimAuctions(newSet);
      });

      // Save filtered notifications back to localStorage
      if (validNotifications.length !== stored.length) {
        saveClaimNotifications(validNotifications);
      }

      // Reset lastCheckedClaimBlock if no stored notifications
      if (stored.length === 0) {
        console.log(
          `🔄 [Claim] No stored notifications found, resetting lastCheckedClaimBlock to 0`
        );
        setLastCheckedClaimBlock(0);
      }
    }, 150); // ✅ Slightly longer delay for claim notifications

    return () => clearTimeout(timer);
  }, []);

  // ✅ RESERVE AUCTION VIOLATION HANDLING
  const handleReserveAuctionViolation = useCallback(
    async (auctionId: number, auctionData: any) => {
      if (!address || !isConnected) return;

      try {
        console.log(
          `🔧 [Reserve Handler] Handling violation for auction #${auctionId}`
        );

        const provider = new ethers.BrowserProvider(window.ethereum as any);
        const signer = await provider.getSigner();
        const auctionContract = new ethers.Contract(
          contracts.MooveAuction.address,
          contracts.MooveAuction.abi,
          signer
        );

        // Check if current user is admin or seller
        const isAdmin =
          address.toLowerCase() ===
          process.env.NEXT_PUBLIC_ADMIN_ADDRESS?.toLowerCase();
        const isSeller =
          auctionData.seller.toLowerCase() === address.toLowerCase();

        if (isAdmin || isSeller) {
          console.log(
            `🔧 [Reserve Handler] User is ${
              isAdmin ? "admin" : "seller"
            }, attempting to cancel auction`
          );

          // Check auction status - can only cancel PENDING or ACTIVE auctions
          const auctionStatus = Number(auctionData.status);
          const canCancel = auctionStatus === 0 || auctionStatus === 1; // PENDING or ACTIVE

          let cancelTx;
          if (canCancel) {
            // Try to cancel the auction (this should refund all bidders and return NFT to seller)
            cancelTx = await (auctionContract as any).cancelAuction(
              auctionId,
              "Reserve price not met"
            );
          } else if (isAdmin) {
            // For ENDED auctions, admin can use emergencyCancel
    console.log(
              `🔧 [Reserve Handler] Auction is ENDED, using emergencyCancel`
            );
            cancelTx = await (auctionContract as any).emergencyCancel(
      auctionId,
              "Reserve price not met"
            );
          } else {
            console.log(
              `⚠️ [Reserve Handler] Cannot cancel ENDED auction as seller`
            );
            toast.error(
              "Cannot cancel ENDED auction. Only admin can handle this."
            );
            return false;
          }
          console.log(
            `📝 [Reserve Handler] Cancel transaction sent: ${cancelTx.hash}`
          );

          const receipt = await cancelTx.wait();
          console.log(
            `✅ [Reserve Handler] Auction #${auctionId} cancelled successfully`
          );

          // Show success notification
          toast.success(
            `✅ Reserve Auction #${auctionId} cancelled. All bidders refunded, NFT returned to seller.`
          );

          return true;
        } else {
    console.log(
            `⚠️ [Reserve Handler] User is not admin or seller, cannot cancel auction`
          );
          return false;
        }
      } catch (error) {
        console.error(
          `❌ [Reserve Handler] Error handling violation for auction #${auctionId}:`,
          error
        );
        toast.error(
          `Failed to cancel Reserve Auction #${auctionId}: ${
            error instanceof Error ? error.message : "Unknown error"
          }`
        );
        return false;
      }
    },
    [address, isConnected]
  );

  // ✅ RESERVE AUCTION VIOLATION DETECTION
  const checkReserveAuctionViolations = useCallback(async () => {
    if (!address || !isConnected) return;

    try {
      console.log(
        `🔍 [Reserve Monitor] Checking for Reserve Auction violations...`
      );

      const provider = new ethers.BrowserProvider(window.ethereum as any);
      const auctionContract = new ethers.Contract(
        contracts.MooveAuction.address,
        contracts.MooveAuction.abi,
        provider
      );

      // ✅ RATE LIMITING: Reduce check range to prevent circuit breaker
      const maxCheckAuctions = 10;
      let highestAuctionId = 0;

      // ✅ RATE LIMITING: Add delay between calls
      const delay = (ms: number) =>
        new Promise((resolve) => setTimeout(resolve, ms));

      // Find highest auction ID with delays
      for (let i = maxCheckAuctions; i >= 0; i--) {
        try {
          const auctionData = await auctionContract.getAuction(i);
          if (
            auctionData &&
            auctionData.seller !== "0x0000000000000000000000000000000000000000"
          ) {
            highestAuctionId = i;
            break;
          }
          // ✅ Add delay to prevent circuit breaker
          await delay(200);
    } catch (error) {
          // Auction doesn't exist, continue
          await delay(100);
        }
      }

      console.log(
        `🔍 [Reserve Monitor] Found highest auction ID: ${highestAuctionId}`
      );

      // ✅ RATE LIMITING: Check only last 3 auctions for violations
      const checkRange = Math.min(3, highestAuctionId + 1);
      for (
        let auctionId = highestAuctionId;
        auctionId >= Math.max(0, highestAuctionId - checkRange);
        auctionId--
      ) {
        try {
          const auctionData = await auctionContract.getAuction(auctionId);

          // ✅ Add delay between each auction check
          await delay(300);

          if (
            !auctionData ||
            auctionData.seller === "0x0000000000000000000000000000000000000000"
          ) {
            continue;
          }

          // Check if this is a Reserve Auction that ended below reserve
          if (Number(auctionData.auctionType) === 3) {
            // Reserve Auction
            const winningBid = BigInt(auctionData.highestBid);
            const reservePrice = BigInt(auctionData.reservePrice);
            const status = Number(auctionData.status);
            const endTime = Number(auctionData.endTime);
            const now = Math.floor(Date.now() / 1000);
            const isEnded = status === 3; // ENDED status (contract definition)
            const isExpired = status === 1 && now > endTime; // ACTIVE but expired
            const isBelowReserve = winningBid < reservePrice;

            if ((isEnded || isExpired) && isBelowReserve && winningBid > 0n) {
              const violationType = isEnded ? "ENDED" : "EXPIRED";
              console.warn(
                `🚨 [Reserve Monitor] VIOLATION DETECTED: Auction #${auctionId} ${violationType} below reserve!`,
                {
                  auctionId,
                  status,
                  endTime,
                  now,
                  isEnded,
                  isExpired,
                  winningBid: ethers.formatEther(winningBid),
                  reservePrice: ethers.formatEther(reservePrice),
                  seller: auctionData.seller,
                  highestBidder: auctionData.highestBidder,
                }
              );

              // Check if current user is the seller
              if (auctionData.seller.toLowerCase() === address.toLowerCase()) {
                const notificationId = `reserve-violation-seller-${auctionId}`;

                // Check if we already notified about this violation
                const existingNotification = refundNotifications.find(
                  (n) => n.id === notificationId
                );
                if (!existingNotification) {
                  const violationNotification: RefundNotification = {
                    id: notificationId,
                    message: `🚨 CRITICAL: Reserve Auction #${auctionId} ended below reserve price! NFT should be returned to you. Click to cancel auction and refund all bidders.`,
                    timestamp: Date.now(),
                    isRead: false,
                    auctionId: auctionId.toString(),
                    amount: ethers.formatEther(winningBid),
                    transactionHash: "reserve-violation",
                  };

                  addRefundNotification(violationNotification);
                  console.log(
                    `📢 [Reserve Monitor] Added violation notification for seller`
                  );
                }
              }

              // Check if current user is the highest bidder
              if (
                auctionData.highestBidder.toLowerCase() ===
                address.toLowerCase()
              ) {
                const notificationId = `reserve-violation-bidder-${auctionId}`;

                const existingNotification = refundNotifications.find(
                  (n) => n.id === notificationId
                );
                if (!existingNotification) {
                  const violationNotification: RefundNotification = {
                    id: notificationId,
                    message: `⚠️ Auction #${auctionId} ended below reserve price. Your bid of ${ethers.formatEther(
                      winningBid
                    )} ETH will be refunded. Do NOT claim this auction.`,
                    timestamp: Date.now(),
                    isRead: false,
                    auctionId: auctionId.toString(),
                    amount: ethers.formatEther(winningBid),
                    transactionHash: "reserve-violation",
                  };

                  addRefundNotification(violationNotification);
        console.log(
                    `📢 [Reserve Monitor] Added violation notification for bidder`
                  );
                }
              }
            }
          }
        } catch (error) {
          // Auction doesn't exist or error reading, continue
          await delay(150);
        }
      }
    } catch (error) {
      console.error(`❌ [Reserve Monitor] Error checking violations:`, error);
    }
  }, [address, isConnected]); // ✅ Removed refundNotifications - not needed for logic

  // ✅ OPTIMIZATION: Debounced monitoring initialization
  const initializeMonitoring = useCallback(() => {
    if (!address || !isConnected) return;

    console.log(`🚀 [Optimized] Initializing monitoring for user ${address}`);

    // ✅ DEBOUNCING: Execute initial fetches with staggered delays
    const delays = [1000, 2000, 3000]; // 1s, 2s, 3s delays
    const functions = [
      fetchRefundEvents,
      fetchClaimEvents,
      checkReserveAuctionViolations,
    ];

    functions.forEach((fn, index) => {
      setTimeout(() => {
        try {
          fn();
        } catch (error) {
          console.error(`❌ [Optimized] Error in ${fn.name}:`, error);
        }
      }, delays[index]);
    });
  }, [
    address,
    isConnected,
    fetchRefundEvents,
    fetchClaimEvents,
    checkReserveAuctionViolations,
  ]);

  // ✅ OPTIMIZATION: Conditional loading - only initialize when needed
  useEffect(() => {
    // Only initialize if user is connected and we haven't initialized yet
    if (address && isConnected) {
      console.log(`🚀 [Conditional] User connected, initializing monitoring`);
      initializeMonitoring();
    } else {
        console.log(
        `⏸️ [Conditional] User not connected, skipping initialization`
      );
    }
  }, [address, isConnected, initializeMonitoring]);

  // ✅ CLEANUP: Function to remove duplicates from existing notifications
  const removeDuplicatesFromNotifications = useCallback(() => {
    console.log(
      `🧹 [Dedupe] Starting duplicate removal from existing notifications...`
    );

    // Clean refund notifications
    const uniqueRefundNotifications = refundNotifications.filter(
      (notification, index, self) =>
        index === self.findIndex((n) => n.id === notification.id)
    );

    // Clean claim notifications
    const uniqueClaimNotifications = claimNotifications.filter(
      (notification, index, self) =>
        index === self.findIndex((n) => n.id === notification.id)
    );

    const refundDuplicatesRemoved =
      refundNotifications.length - uniqueRefundNotifications.length;
    const claimDuplicatesRemoved =
      claimNotifications.length - uniqueClaimNotifications.length;

    console.log(
      `📊 [Dedupe] Removed ${refundDuplicatesRemoved} refund duplicates and ${claimDuplicatesRemoved} claim duplicates`
    );

    // Update notifications if duplicates were found
    if (refundDuplicatesRemoved > 0 || claimDuplicatesRemoved > 0) {
      // Clear all and add back only unique ones
      clearAllRefundNotifications();
      clearAllClaimNotifications();

      uniqueRefundNotifications.forEach((notification) => {
        addRefundNotification(notification);
      });

      uniqueClaimNotifications.forEach((notification) => {
        addClaimNotification(notification);
      });

      // Update localStorage
      saveRefundNotifications(uniqueRefundNotifications);
      saveClaimNotifications(uniqueClaimNotifications);

      console.log(`✅ [Dedupe] Duplicate removal completed successfully`);
    } else {
      console.log(`✅ [Dedupe] No duplicates found`);
    }
  }, [
    refundNotifications,
    claimNotifications,
    clearAllRefundNotifications,
    clearAllClaimNotifications,
    addRefundNotification,
    addClaimNotification,
  ]);

  // ✅ EMERGENCY CLEANUP: Complete reset of all notifications
  const emergencyCleanup = useCallback(() => {
    console.log(`🚨 [Emergency] Starting complete notification cleanup...`);

    // Clear all notifications from state
    clearAllRefundNotifications();
    clearAllClaimNotifications();

    // Clear localStorage
    if (typeof window !== "undefined") {
      localStorage.removeItem("moove-refund-notifications");
      localStorage.removeItem("moove-claim-notifications");
      localStorage.removeItem("moove-last-checked-block");
      localStorage.removeItem("moove-last-checked-claim-block");
      localStorage.removeItem("moove-processed-claim-auctions");
    }

    // Reset block tracking
    setLastCheckedBlock(0);
    setLastCheckedClaimBlock(0);

    console.log(
      `✅ [Emergency] Complete cleanup finished - all notifications cleared`
    );
  }, [clearAllRefundNotifications, clearAllClaimNotifications]);

  // ✅ CLEANUP: Auto-deduplication on load
  useEffect(() => {
    if (refundNotifications.length > 0 || claimNotifications.length > 0) {
      console.log(
        `🧹 [Auto-Dedupe] Found ${refundNotifications.length} refund + ${claimNotifications.length} claim notifications, running deduplication...`
      );
      removeDuplicatesFromNotifications();
    }
  }, []); // Run once on mount

  // Context value
  const contextValue: AuctionNotificationsContextType = {
    hasUnsettledAuctions: wonAuctions.length > 0,
    unsettledCount: wonAuctions.length,
    showNotifications,
    setShowNotifications,
    currentAuction,
    unsettledAuctions: wonAuctions as unknown as WonAuction[],
    isSettling,
    transactionHash,
    isWaitingForConfirmation,
    handleSettleAuction,
    // New 3-phase system states
    showConfirmationModal,
    showResultModal,
    selectedAuction,
    transactionResult,
    // Sealed bid monitoring
    addToSealedBidMonitoring: addToMonitoring,
    removeFromSealedBidMonitoring: removeFromMonitoring,
    monitoredSealedBidAuctions: monitoredAuctions,
    isMonitoringSealedBids,
    sealedBidError,
    // Refund notifications
    refundNotifications,
    markRefundAsRead,
    clearAllRefundNotifications,
    removeRefundNotification,
    // Claim notifications
    claimNotifications,
    markClaimAsRead,
    clearAllClaimNotifications,
    removeClaimNotification,
    claimPermanentNotification, // ✅ NEW: Function to claim permanent notifications
    removeDuplicatesFromNotifications, // ✅ NEW: Function to remove duplicates
    emergencyCleanup, // ✅ NEW: Emergency complete cleanup
    // Debug functions
    resetRefundBlock,
    resetClaimBlock,
    clearAllNotifications,
  };

  return (
    <AuctionNotificationsContext.Provider value={contextValue}>
      {children}

      {/* Notification Badge */}
      <ConsolidatedNotificationBadge />

      {/* Debug Panel */}
      <AuctionNotificationsDebug />
    </AuctionNotificationsContext.Provider>
  );
};

export { AuctionNotificationsContext };
