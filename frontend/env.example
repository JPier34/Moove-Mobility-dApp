# Moove Mobility NFT Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# Ethereum RPC URL (Required)
# Use a reliable RPC provider like Infura, Alchemy, or QuickNode
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ===========================================
# DEVELOPMENT & DEPLOYMENT
# ===========================================

# Development Environment
NODE_ENV=development

# Private Key for Contract Deployment (Development Only)
# ⚠️ NEVER use mainnet private keys in development
PRIVATE_KEY=your_private_key_here

# ===========================================
# SMART CONTRACTS
# ===========================================

# Master Wallet Address (Admin)
NEXT_PUBLIC_MASTER_WALLET_ADDRESS=0x...

# Moove NFT Contract Address (Required)
NEXT_PUBLIC_MOOVE_NFT_ADDRESS=0x40E455515bf712144C1A5D859F19d64b537754f7

# Moove Auction Contract Address (Required)
NEXT_PUBLIC_MOOVE_AUCTION_ADDRESS=0xE8f6836A0054B83b9a952e8B62D92e62f5c67606

# Moove Rental Pass Contract Address (Required)
NEXT_PUBLIC_MOOVE_RENTAL_PASS_ADDRESS=0x52d95a8Fd4D8c0Ad210DCAD3BA8EBd533EB5420a

# Moove Access Control Contract Address (Required)
NEXT_PUBLIC_MOOVE_ACCESS_CONTROL_ADDRESS=0x93b6F6F4b28cd61F68c16A85c9FC107Bf8f47e42

# ===========================================
# IPFS CONFIGURATION
# ===========================================

# Pinata API Configuration (Required for NFT metadata)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# IPFS Gateway URL
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ===========================================
# BLOCKCHAIN EXPLORER
# ===========================================

# Network Explorer URL
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# ===========================================
# WALLET CONNECT
# ===========================================

# WalletConnect Project ID (Optional)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ===========================================
# GOOGLE MAPS (Optional)
# ===========================================

# Google Maps API Key (Optional - for geolocation features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# SECURITY NOTES
# ===========================================
# 
# 1. Never commit your .env.local file to version control
# 2. Use environment-specific values for different deployments
# 3. Rotate your API keys regularly
# 4. Use strong, unique values for all secrets
# 5. Monitor your RPC usage to avoid rate limits
# 6. Keep your private keys secure and never share them
# 7. Use different keys for development and production
#
# ===========================================