"use client";

import React, { useState } from "react";
import { AuctionType } from "@/types/auction";
import { useAuctionValidationModular } from "@/hooks/useAuctionValidationModular";
import { useAuctionFormValidation } from "@/hooks/useAuctionFormValidation";
import { AUCTION_TYPE_RULES } from "@/hooks/useAuctionValidationModular";

interface ModularValidationTesterProps {
  className?: string;
}

export default function ModularValidationTester({
  className = "",
}: ModularValidationTesterProps) {
  const { formData, validation, updateField, validateForTransaction } =
    useAuctionValidationModular();
  const { areRequiredFieldsFilled, getValidationSummary } =
    useAuctionFormValidation(formData);
  const [testResults, setTestResults] = useState<string[]>([]);

  const runModularTests = () => {
    const results: string[] = [];

    // Test 1: Required fields validation
    results.push("🧪 Testing Required Fields Validation:");
    Object.values(AuctionType).forEach((auctionType) => {
      if (typeof auctionType === "number") {
        const rules = AUCTION_TYPE_RULES[auctionType];
        if (rules) {
          results.push(
            `  ✅ ${rules.name}: Required fields: ${rules.requiredFields.join(
              ", "
            )}`
          );
          results.push(
            `  📝 ${rules.name}: Optional fields: ${rules.optionalFields.join(
              ", "
            )}`
          );
        }
      }
    });

    // Test 2: Form validation
    results.push("\n🧪 Testing Form Validation:");
    const summary = getValidationSummary();
    results.push(`  📊 Current auction type: ${summary.auctionTypeName}`);
    results.push(
      `  ✅ Required fields filled: ${areRequiredFieldsFilled ? "YES" : "NO"}`
    );
    results.push(`  📋 Required fields: ${summary.requiredFields.join(", ")}`);
    results.push(`  📝 Optional fields: ${summary.optionalFields.join(", ")}`);

    // Test 3: Transaction validation
    results.push("\n🧪 Testing Transaction Validation:");
    const transactionValidation = validateForTransaction();
    results.push(
      `  ✅ Transaction validation: ${
        transactionValidation.isValid ? "PASS" : "FAIL"
      }`
    );
    if (!transactionValidation.isValid) {
      results.push(`  ❌ Error: ${transactionValidation.error}`);
    }

    // Test 4: Validation errors
    results.push("\n🧪 Testing Validation Errors:");
    if (validation.errors.length > 0) {
      validation.errors.forEach((error, index) => {
        results.push(
          `  ❌ Error ${index + 1}: ${error.field} - ${error.message}`
        );
      });
    } else {
      results.push(`  ✅ No validation errors`);
    }

    // Test 5: Validation warnings
    results.push("\n🧪 Testing Validation Warnings:");
    if (validation.warnings.length > 0) {
      validation.warnings.forEach((warning, index) => {
        results.push(
          `  ⚠️ Warning ${index + 1}: ${warning.field} - ${warning.message}`
        );
      });
    } else {
      results.push(`  ✅ No validation warnings`);
    }

    setTestResults(results);
  };

  const clearTests = () => {
    setTestResults([]);
  };

  const testAuctionTypes = () => {
    const results: string[] = [];

    Object.values(AuctionType).forEach((auctionType) => {
      if (typeof auctionType === "number") {
        updateField("auctionType", auctionType);

        setTimeout(() => {
          const summary = getValidationSummary();
          results.push(`🎯 ${summary.auctionTypeName}:`);
          results.push(`  Required: ${summary.requiredFields.join(", ")}`);
          results.push(`  Optional: ${summary.optionalFields.join(", ")}`);
          results.push(
            `  Valid: ${summary.isFormCompletelyValid ? "YES" : "NO"}`
          );
          results.push("");
        }, 100);
      }
    });

    setTimeout(() => {
      setTestResults(results);
    }, 1000);
  };

  return (
    <div className={`p-6 bg-white rounded-lg shadow ${className}`}>
      <h3 className="text-lg font-semibold text-gray-900 mb-4">
        🧪 Modular Validation System Tester
      </h3>

      {/* Current Form State */}
      <div className="mb-6">
        <h4 className="text-md font-semibold text-gray-800 mb-3">
          📋 Current Form State
        </h4>
        <div className="bg-gray-50 rounded-lg p-4">
          <div className="grid grid-cols-2 gap-4 text-sm">
            <div>
              <span className="font-medium">Auction Type:</span>{" "}
              {formData.auctionType}
            </div>
            <div>
              <span className="font-medium">Start Price:</span>{" "}
              {formData.startPrice || "Empty"}
            </div>
            <div>
              <span className="font-medium">Duration:</span>{" "}
              {formData.duration || "Empty"} {formData.durationUnit}
            </div>
            <div>
              <span className="font-medium">Bid Increment:</span>{" "}
              {formData.bidIncrement || "Empty"}
            </div>
            <div>
              <span className="font-medium">Reserve Price:</span>{" "}
              {formData.reservePrice || "Empty"}
            </div>
            <div>
              <span className="font-medium">Buy Now Price:</span>{" "}
              {formData.buyNowPrice || "Empty"}
            </div>
          </div>
          <div className="mt-3 grid grid-cols-2 gap-4">
            <div>
              <span className="font-medium">Form Valid:</span>{" "}
              <span
                className={`px-2 py-1 rounded-full text-xs font-medium ${
                  validation.isValid
                    ? "bg-green-100 text-green-800"
                    : "bg-red-100 text-red-800"
                }`}
              >
                {validation.isValid ? "✅ Valid" : "❌ Invalid"}
              </span>
            </div>
            <div>
              <span className="font-medium">Required Fields:</span>{" "}
              <span
                className={`px-2 py-1 rounded-full text-xs font-medium ${
                  areRequiredFieldsFilled
                    ? "bg-green-100 text-green-800"
                    : "bg-red-100 text-red-800"
                }`}
              >
                {areRequiredFieldsFilled ? "✅ Filled" : "❌ Missing"}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Manual Form Controls */}
      <div className="mb-6">
        <h4 className="text-md font-semibold text-gray-800 mb-3">
          🎛️ Manual Form Controls
        </h4>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Auction Type
            </label>
            <select
              value={formData.auctionType}
              onChange={(e) =>
                updateField(
                  "auctionType",
                  Number(e.target.value) as AuctionType
                )
              }
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
            >
              <option value={AuctionType.ENGLISH}>English</option>
              <option value={AuctionType.DUTCH}>Dutch</option>
              <option value={AuctionType.SEALED_BID}>Sealed Bid</option>
              <option value={AuctionType.RESERVE}>Reserve</option>
            </select>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Start Price (ETH)
            </label>
            <input
              type="text"
              value={formData.startPrice}
              onChange={(e) => updateField("startPrice", e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
              placeholder="0.001"
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Duration
            </label>
            <input
              type="text"
              value={formData.duration}
              onChange={(e) => updateField("duration", e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
              placeholder="1"
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Bid Increment (ETH)
            </label>
            <input
              type="text"
              value={formData.bidIncrement}
              onChange={(e) => updateField("bidIncrement", e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
              placeholder="0.0001"
            />
          </div>
        </div>
      </div>

      {/* Test Controls */}
      <div className="mb-6">
        <h4 className="text-md font-semibold text-gray-800 mb-3">
          🧪 Automated Tests
        </h4>
        <div className="flex space-x-4">
          <button
            onClick={runModularTests}
            className="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition-colors"
          >
            Run Modular Tests
          </button>
          <button
            onClick={testAuctionTypes}
            className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
          >
            Test All Auction Types
          </button>
          <button
            onClick={clearTests}
            className="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700 transition-colors"
          >
            Clear Results
          </button>
        </div>
      </div>

      {/* Test Results */}
      {testResults.length > 0 && (
        <div className="mb-4">
          <h4 className="text-md font-semibold text-gray-800 mb-3">
            📊 Test Results
          </h4>
          <div className="bg-gray-50 rounded-lg p-4">
            <pre className="text-sm text-gray-700 whitespace-pre-wrap">
              {testResults.join("\n")}
            </pre>
          </div>
        </div>
      )}

      {/* Validation Summary */}
      <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h4 className="text-md font-semibold text-blue-800 mb-2">
          📋 Modular System Benefits
        </h4>
        <div className="text-sm text-blue-700 space-y-1">
          <div>
            • <strong>Single Source of Truth:</strong> All validation rules in
            one place
          </div>
          <div>
            • <strong>No Duplication:</strong> Eliminated hardcoded validation
            logic
          </div>
          <div>
            • <strong>Type Safety:</strong> Consistent validation across all
            components
          </div>
          <div>
            • <strong>Modular Design:</strong> Easy to extend and maintain
          </div>
          <div>
            • <strong>Consistent Behavior:</strong> Same validation rules
            everywhere
          </div>
        </div>
      </div>
    </div>
  );
}
